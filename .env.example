# ===================== Servidor =====================
PORT=3000
# URL pública HTTPS onde o app vai rodar (usada no webhook, nos QR codes e nos links)
PUBLIC_URL=https://raizes.seudominio.com.br
TZ=America/Sao_Paulo
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# E-mails com acesso à tela Admin (lista de espera, usuários, pagamentos)
ADMIN_EMAILS=seu-email@exemplo.com
# Pasta dos áudios (e do SQLite, se não usar MySQL)
DATA_DIR=./data

# ===================== Banco de dados (MySQL / MariaDB) =====================
# Deixe DB_HOST vazio para usar SQLite local (bom para desenvolvimento).
DB_HOST=192.168.15.160
DB_PORT=3306
DB_USER=sadmin
DB_PASSWORD=
DB_NAME=raizes
# Cria o banco automaticamente na primeira execução (precisa de permissão CREATE)
DB_CREATE_DATABASE=true

# ===================== WhatsApp (WAHA) =====================
WAHA_URL=https://whatsapp2.x-star.com.br
WAHA_API_KEY=
WAHA_SESSION=default
# Segredo que vai na URL do webhook. Gere um valor longo e aleatório.
WAHA_WEBHOOK_SECRET=

# ===================== IA =====================
# Claude: conduz a conversa, cria perguntas de aprofundamento e escreve as histórias
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# OpenAI: transcreve os áudios e gera a voz das perguntas
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# ===================== Conversa =====================
FOLLOW_UPS=2            # perguntas de aprofundamento por conversa
DEBOUNCE_SECONDS=40     # espera o idoso terminar de mandar vários áudios seguidos
REMINDER_HOURS=48       # lembrete gentil se não responder
CLOSE_HOURS=96          # fecha a conversa e gera a história com o que tiver
TRIAL_CONVERSATIONS=2   # conversas grátis antes de pedir o plano

# ===================== Pagamentos (Mercado Pago) =====================
# Painel do Mercado Pago > Suas integrações > Credenciais de produção > Access Token
MP_ACCESS_TOKEN=
PLAN_PRICE=299
BOOK_PRICE=199
